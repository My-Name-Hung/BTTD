# =========================================================
# Google Drive — Lưu file biên bản nghiệm thu
# =========================================================
# Quan trọng: Service Account KHÔNG có storage quota trên My Drive cá nhân.
# PHẢI dùng SHARED DRIVE (Ổ đĩa dùng chung).
#
# Cách setup:
# 1. Tạo Service Account trong Google Cloud Console.
# 2. Download file JSON key, đặt vào thư mục backend.
# 3. Điền GOOGLE_APPLICATION_CREDENTIALS.
# 4. Tạo SHARED DRIVE trên Google Drive
#    (vào https://drive.google.com → Dùng chung với tôi → Tạo ổ đĩa dùng chung)
# 5. Thêm email Service Account vào Shared Drive (quyền Content Manager hoặc Editor):
#    drive-340@gen-lang-client-0456818632.iam.gserviceaccount.com
# 6. Copy Folder ID của Shared Drive vào GOOGLE_DRIVE_FOLDER_ID
#    (URL có dạng: drive.google.com/drive/folders/[FOLDER_ID])

# Email Service Account:
GOOGLE_SERVICE_ACCOUNT_EMAIL=drive-340@gen-lang-client-0456818632.iam.gserviceaccount.com

# Đường dẫn đến file JSON key của Service Account
GOOGLE_APPLICATION_CREDENTIALS=./gen-lang-client-0456818632-16feae46d4bd.json

# SHARED DRIVE Folder ID (bắt buộc)
# Lấy từ URL Shared Drive: https://drive.google.com/drive/folders/[ĐÂY_LÀ_FOLDER_ID]
# Ví dụ: https://drive.google.com/drive/folders/1ABC123xyz... → Folder ID = 1ABC123xyz...
GOOGLE_DRIVE_FOLDER_ID=1ABC123xyzYOURSHAREDDRIVEFOLDERID
